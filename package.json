{
  "name": "strata-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Visual editor for building, organizing and tracking dependency graphs, grouped into configurable sections and adaptable to any domain.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs/wiki",
    "docs:build": "vitepress build docs/wiki",
    "docs:preview": "vitepress preview docs/wiki"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "html-to-image": "^1.11.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.0.3",
    "vitepress": "^1.6.4"
  }
}
